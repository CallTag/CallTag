# Contoh dokumentasi, bukan konfigurasi production siap pakai.
# Backend baseline membaca environment proses dan tidak memuat dotenv otomatis.
PORT=8080
DB_NAME=calltag_audit
MONGOSTRING=mongodb://127.0.0.1:28018
# Isi secara privat dengan nilai acak kuat dan berbeda; jangan commit nilai nyata.
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
HASH_SALT=REPLACE_WITH_SEPARATE_RANDOM_IDENTITY_KEY
